# Copy this file to .env and adjust the values for your machine.
# Existing system environment variables take precedence over this file.

MONITOR_ENABLE_COOLER=true
MONITOR_ICUE_LOG_DIR=C:\path\to\icue_logs
MONITOR_COOLER_REFRESH_SECONDS=5
MONITOR_COOLER_BACKOFF_SECONDS=300
MONITOR_COOLER_FAN_MAX_RPM=2000
MONITOR_COOLER_PUMP_MAX_RPM=2850
